# Chiffrement des identifiants « se souvenir de moi » — obligatoire, à générer une fois
SECRET_KEY=

# Comptes autorisés sur /api/admin/* (séparés par des virgules)
ADMIN_USERNAMES=

# Notifications push. Laissées vides, les clés sont générées et conservées dans data/vapid.keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notes-iut@example.com

# Veille des nouvelles notes (valeurs par défaut)
PUSH_POLL_INTERVAL=600
PUSH_INITIAL_DELAY=60
PUSH_MAX_CONCURRENT_CHECKS=2
PUSH_TICK_INTERVAL_SECONDS=60
PUSH_STAGGER_WINDOW_SECONDS=300
PUSH_BACKOFF_MAX_SECONDS=3600
